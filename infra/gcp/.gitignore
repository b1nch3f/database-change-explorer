# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform directories
.terraform/
.terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Variable files (if they contain sensitive data)
# Uncomment if you want to ignore custom tfvars
# *.tfvars
# *.tfvars.json

# Ignore sensitive files
*.pem
*.key
secrets.auto.tfvars
